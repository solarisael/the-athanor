<node id="n_3f00f4e3c358c3ad3fc3b7ba"><data key="label">athanor chat [--room ROOM]</data><data key="kind">command</data><data key="description">Terminal chat: opens the room WebSocket with the client bearer, subscribes, and sends athanor.chat.say per stdin line.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/src/cli/chat.rs&quot;,&quot;line&quot;:78,&quot;endLine&quot;:133}]</data><data key="entityId">command:athanor-chat</data></node>
<node id="n_e76a3e7cd27c41cc3265fabb"><data key="label">athanor doctor</data><data key="kind">command</data><data key="description">Installation check mode, routed through manage.rs to the doctor report.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/src/cli/mod.rs&quot;,&quot;line&quot;:55,&quot;endLine&quot;:62},{&quot;path&quot;:&quot;crates/athanor-install/src/lib.rs&quot;,&quot;line&quot;:40,&quot;endLine&quot;:247}]</data><data key="entityId">command:athanor-doctor</data></node>
<node id="n_cc8c6b71870d5a86ba9beb15"><data key="label">athanor install / update</data><data key="kind">command</data><data key="description">Installs or upgrades a staged native release from --staging and --manifest, with optional database, house, and OMP integration flags.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/src/cli/manage.rs&quot;,&quot;line&quot;:17,&quot;endLine&quot;:20},{&quot;path&quot;:&quot;crates/athanor-install/src/cli/mod.rs&quot;,&quot;line&quot;:28,&quot;endLine&quot;:29}]</data><data key="entityId">command:athanor-install</data></node>
<node id="n_2cc54540324e7bacb01e269e"><data key="label">athanor install-omp-adapter --source DIR</data><data key="kind">command</data><data key="description">Verifies and activates an OMP adapter component release.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/src/cli/mod.rs&quot;,&quot;line&quot;:30,&quot;endLine&quot;:30},{&quot;path&quot;:&quot;crates/athanor-install/src/installer.rs&quot;,&quot;line&quot;:576,&quot;endLine&quot;:606}]</data><data key="entityId">command:athanor-install-omp-adapter</data></node>
<node id="n_a8be5d4b4f0d90f763687861"><data key="label">athanor keeper ROOM | --config FILE</data><data key="kind">command</data><data key="description">Runs the omp_keeper loop for one room; ROOM resolves through the harness registry.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/src/cli/keeper.rs&quot;,&quot;line&quot;:30,&quot;endLine&quot;:67}]</data><data key="entityId">command:athanor-keeper</data></node>
<node id="n_ad62a15b407a89e124f9ae9a"><data key="label">athanor launch-session --manifest FILE</data><data key="kind">command</data><data key="description">Claims a one-use Host launch manifest, then runs the harness in the pane console and returns its exit code.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/src/cli/launch.rs&quot;,&quot;line&quot;:22,&quot;endLine&quot;:63}]</data><data key="entityId">command:athanor-launch-session</data></node>
<node id="n_255f90dd5bbc511c009af6ab"><data key="label">athanor rollback</data><data key="kind">command</data><data key="description">Native rollback: undo backup, stop service, swap pointers, restore database, start and wait.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/src/installer.rs&quot;,&quot;line&quot;:498,&quot;endLine&quot;:575}]</data><data key="entityId">command:athanor-rollback</data></node>
<node id="n_a030a40c8f59bb93ea5bec1c"><data key="label">athanor rollback-omp-adapter [--release-id ID]</data><data key="kind">command</data><data key="description">Moves the adapter pointer to a named or previous retained release.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/src/cli/mod.rs&quot;,&quot;line&quot;:31,&quot;endLine&quot;:31},{&quot;path&quot;:&quot;crates/athanor-install/src/installer.rs&quot;,&quot;line&quot;:607,&quot;endLine&quot;:620}]</data><data key="entityId">command:athanor-rollback-omp-adapter</data></node>
<node id="n_20f098390e25e6462efb0e1b"><data key="label">athanor service</data><data key="kind">command</data><data key="description">SCM entry point; hands the service name and entry function to the control dispatcher.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/src/cli/mod.rs&quot;,&quot;line&quot;:49,&quot;endLine&quot;:49},{&quot;path&quot;:&quot;crates/athanor-install/src/service.rs&quot;,&quot;line&quot;:159,&quot;endLine&quot;:177}]</data><data key="entityId">command:athanor-service</data></node>
<node id="n_825595b47caea7494328aeda"><data key="label">athanor start [--service]</data><data key="kind">command</data><data key="description">Starts only missing parts: service via sc start, waits for PostgreSQL and NATS, spawns a detached Host. Keepers are not started.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/src/cli/start.rs&quot;,&quot;line&quot;:53,&quot;endLine&quot;:163}]</data><data key="entityId">command:athanor-start</data></node>
<node id="n_88104ab385f7a279a98a754e"><data key="label">athanor status</data><data key="kind">command</data><data key="description">Prints one component matrix: service, PostgreSQL, NATS, Ollama, Host, and each registered keeper.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/src/cli/status.rs&quot;,&quot;line&quot;:59,&quot;endLine&quot;:62}]</data><data key="entityId">command:athanor-status</data></node>
<node id="n_0c88cbe387ab92b5bddd43fd"><data key="label">athanor uninstall / purge</data><data key="kind">command</data><data key="description">Stops and removes the service, unregisters the loader, removes program tree; purge also removes data with --confirm-data-loss.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/src/installer.rs&quot;,&quot;line&quot;:1180,&quot;endLine&quot;:1215}]</data><data key="entityId">command:athanor-uninstall</data></node>
<node id="n_4e7c26fb07fa17e4f505284c"><data key="label">athanor.exe (the one exe)</data><data key="kind">component</data><data key="description">One Windows binary. No argument runs the Host app; the first argument selects every other mode.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/Cargo.toml&quot;,&quot;line&quot;:11,&quot;endLine&quot;:15},{&quot;path&quot;:&quot;crates/athanor-install/src/cli/mod.rs&quot;,&quot;line&quot;:1,&quot;endLine&quot;:67}]</data><data key="entityId">component:athanor-desktop</data></node>
<node id="n_d8b4e67d9140a6175fa7d06b"><data key="label">Windows service SolarisaelAthanor</data><data key="kind">component</data><data key="description">athanor.exe service mode under SCM. Runs the supervisor that keeps PostgreSQL and NATS alive.</data><data key="sources">[{&quot;path&quot;:&quot;crates/athanor-install/src/layout.rs&quot;,&quot;line&quot;:5,&quot;endLine&quot;:6},{&quot;path&quot;:&quot;crates/athanor-install/src/service.rs&quot;,&quot;line&quot;:159,&quot;endLine&quot;:177},{&quot;path&quot;:&quot;crates/athanor-install/src/service.rs&quot;,&quot;line&quot;:288,&quot;endLine&quot;:354}]</data><data key="entityId">component:athanor-service</data></node>
