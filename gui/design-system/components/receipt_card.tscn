[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://design-system/components/receipt_card.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://design-system/components/disclosure_banner.tscn" id="2_disclosure"]

[node name="ReceiptCard" type="PanelContainer"]
custom_minimum_size = Vector2(0, 128)
layout_mode = 2
theme_type_variation = &"AthanorPaperBoat"
script = ExtResource("1_script")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_type_variation = &"AthanorPaperColumn"

[node name="Header" type="HBoxContainer" parent="Column"]
layout_mode = 2
theme_type_variation = &"AthanorBarRow"

[node name="Title" type="Label" parent="Column/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"AthanorStatusValue"
text = "Latest Paper Boat"

[node name="Timestamp" type="Label" parent="Column/Header"]
layout_mode = 2
size_flags_horizontal = 2
theme_type_variation = &"AthanorMeta"
text = "— · ROOM —"

[node name="Delivered" type="HBoxContainer" parent="Column"]
layout_mode = 2
theme_type_variation = &"AthanorBarRow"

[node name="Label" type="Label" parent="Column/Delivered"]
layout_mode = 2
theme_type_variation = &"AthanorStatusLabel"
text = "DELIVERED"

[node name="Value" type="Label" parent="Column/Delivered"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"AthanorStatusValue"
text = "PENDING · waiting for a verified receipt"
