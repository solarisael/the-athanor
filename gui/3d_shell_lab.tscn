[gd_scene format=3 uid="uid://bfq8lfwtx1b44"]

[ext_resource type="PackedScene" path="res://main.tscn" id="1_shell"]

[sub_resource type="GDScript" id="Boot_shell"]
script/source = "extends Node3D

@onready var shell_viewport: SubViewport = $ShellViewport

func _ready() -> void:
    var surface: MeshInstance3D = $ShellSurface
    var material := StandardMaterial3D.new()
    material.albedo_texture = shell_viewport.get_texture()
    material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
    material.texture_filter = BaseMaterial3D.TEXTURE_FILTER_NEAREST
    surface.set_surface_override_material(0, material)

func _input(event: InputEvent) -> void:
    # Ortho 1:1 frontal surface: window pixels map linearly onto shell texels.
    var window_size := get_viewport().get_visible_rect().size
    if window_size.x <= 0.0 or window_size.y <= 0.0:
        return
    var scale := Vector2(shell_viewport.size) / window_size
    var forwarded := event.duplicate()
    if forwarded is InputEventMouse:
        forwarded.position = forwarded.position * scale
        if forwarded is InputEventMouseMotion:
            forwarded.relative = forwarded.relative * scale
    shell_viewport.push_input(forwarded)
"

