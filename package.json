{
  "name": "the-athanor",
  "version": "0.5.4",
  "description": "A persistent identity, continuity, and memory platform for AI agents and collaborators.",
  "author": "Sol",
  "license": "Apache-2.0",
  "repository": "github:solarisael/the-athanor",
  "type": "module",
  "private": true,
  "workspaces": [
    "adapters/omp"
  ],
  "scripts": {
    "test": "bun run test:rust && bun run test:omp && bun run test:installer",
    "test:rust": "cargo test --workspace",
    "test:omp": "cd adapters/omp && bun run test",
    "test:installer": "pwsh -NoProfile -File installer/native-release-contract.test.ps1 && pwsh -NoProfile -File installer/omp-adapter-component.test.ps1",
    "deploy:omp-adapter": "pwsh -NoProfile -File adapters/omp/deploy-local.ps1",
    "build:pages": "node scripts/build-pages.mjs",
    "build:substrate": "cargo build --release -p akasha",
    "build:godot": "cargo build -p athanor-godot --target-dir gui/target",
    "build:native": "pwsh -File installer/build-native-release.ps1 -OutDir dist/native"
  },
  "devDependencies": {
    "marked": "18.0.10"
  }
}
