theme_type_variation = &"AthanorMeta"
text = "—"
autowrap_mode = 2

[node name="Event" type="HBoxContainer" parent="Column"]
layout_mode = 2
theme_type_variation = &"AthanorBarRow"

[node name="Label" type="Label" parent="Column/Event"]
layout_mode = 2
theme_type_variation = &"AthanorStatusLabel"
text = "EVENT"

[node name="Value" type="Label" parent="Column/Event"]
