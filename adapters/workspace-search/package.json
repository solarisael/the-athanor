{
  "name": "@solarisael/athanor-workspace-search",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Local Nemotron workspace search through the public zvec library.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "files": [
