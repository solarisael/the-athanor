[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://screens/s01_chat_center.gd" id="1_s01"]
[ext_resource type="PackedScene" path="res://design-system/components/page_header.tscn" id="2_page_header"]
[ext_resource type="PackedScene" path="res://design-system/components/receipt_card.tscn" id="3_receipt_card"]
[ext_resource type="PackedScene" path="res://design-system/components/disclosure_banner.tscn" id="4_disclosure_banner"]
[ext_resource type="PackedScene" path="res://design-system/components/composer.tscn" id="5_composer"]

[node name="S01ChatCenter" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"AthanorContentColumn"
script = ExtResource("1_s01")

[node name="Header" parent="." instance=ExtResource("2_page_header")]
layout_mode = 2
kicker_text = "S01 · CONVERSA E RETOMADA"
title_text = "Onde paramos"
lead_text = "Room, spirit e perfil efetivo ficam visíveis sem abrir configurações. O último paper boat e o contexto recuperado abrem a sessão."

[node name="Receipt" parent="." instance=ExtResource("3_receipt_card")]
unique_name_in_owner = true
layout_mode = 2

[node name="Transcript" type="ScrollContainer" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
follow_focus = true
horizontal_scroll_mode = 0

[node name="Column" type="VBoxContainer" parent="Transcript"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_type_variation = &"AthanorSection"

[node name="EmptyState" parent="Transcript/Column" instance=ExtResource("4_disclosure_banner")]
unique_name_in_owner = true
layout_mode = 2
preset = 3

[node name="Messages" type="VBoxContainer" parent="Transcript/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"AthanorSection"

[node name="Composer" parent="." instance=ExtResource("5_composer")]
unique_name_in_owner = true
layout_mode = 2
