{
  "name": "the-athanor",
  "version": "0.9.7.0",
  "description": "A persistent identity, continuity, and memory platform for AI agents and collaborators.",
  "author": "Sol",
  "license": "Apache-2.0",
  "repository": "github:solarisael/the-athanor",
  "type": "module",
  "private": true,
  "workspaces": [
    "adapters/omp"
  ],
  "scripts": {
    "test": "bun run test:rust && bun run test:omp && bun run test:installer",
    "test:rust": "cargo test --workspace",
    "test:omp": "cd adapters/omp && bun run test",
    "test:installer": "pwsh -NoProfile -File installer/native-build-cache.test.ps1",
    "build:pages": "node scripts/build-pages.mjs",
    "build:substrate": "cargo build --release -p athanor-substrate",
    "build:godot": "cargo build -p athanor-godot --target-dir gui/target",
    "build:native": "pwsh -File installer/build-native-release.ps1 -Version 0.9.6.2-rc2 -OutDir dist/native"
  },
  "devDependencies": {
    "marked": "18.0.10"
  }
}
