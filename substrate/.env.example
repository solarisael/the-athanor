# Copy this file to <install-root>/state/substrate/.env and edit secrets
# locally; never commit .env. Mutable state lives outside the immutable product
# tree, so this file does NOT belong beside the substrate sources.
#
# ATHANOR_STATE_DIR names the Athanor state root (<install-root>/state) for
# every substrate entry point: the Rust binary, the Python operations, and
# backup.sh/restore.sh. It must be an absolute path, and it must be set in the
# process environment, not here — this file is read from the location it points
# at. An installed Athanor that does not set it fails loudly rather than
# writing mutable state into the product tree.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=solarisael
PGPASSWORD=replace-me
PGDATABASE=solarisael_memory

# Embedder (optional override). The tested default is Nemotron-3-Embed-1B
# served by the Windows-native Ollama service on port 11434.
SOLARISAEL_EMBED_URL=http://127.0.0.1:11434/api/embed
SOLARISAEL_EMBED_MODEL=hf.co/zenmagnets/Nemotron-3-Embed-1B-Q4_K_M-GGUF:latest
SOLARISAEL_EMBED_DIMENSION=2048

# Number of custom-format dumps retained by backup.sh.
KEEP=14
